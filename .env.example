# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://invoice:invoice@localhost:5432/invoice_pipeline
DATABASE_URL_SYNC=postgresql://invoice:invoice@localhost:5432/invoice_pipeline

# ── Qdrant (self-hosted; `docker compose up qdrant` or bare `docker run qdrant/qdrant`) ──
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_VENDOR_COLLECTION=vendors
# Qdrant Cloud instead (leave QDRANT_URL set to use this over host/port above):
QDRANT_URL=
QDRANT_API_KEY=

# ── LLM provider: ollama | lm_studio | openai | anthropic | gemini | groq | llamacpp | auto ──
LLM_PROVIDER=auto

# Ollama (local, OpenAI-compatible)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b

# LM Studio (local, OpenAI-compatible). Used by default if reachable.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (OpenAI-compatible hosted API)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEMPERATURE=0.0
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT=60.0

# llama.cpp (OpenAI-compatible local server)
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=local-model
LLAMACPP_API_KEY=not-needed
LLAMACPP_CONTEXT_LENGTH=4096
LLAMACPP_TEMPERATURE=0.2
LLAMACPP_MAX_TOKENS=2048

# ── Generation ─────────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2

# ── OCR engine: tesseract | paddleocr ─────────────────────────────────────────
OCR_ENGINE=tesseract

# ── Pipeline ───────────────────────────────────────────────────────────────────
LOW_CONFIDENCE_THRESHOLD=0.75
MAX_UPLOAD_SIZE_MB=25

# ── Webhooks ───────────────────────────────────────────────────────────────────
REVIEW_WEBHOOK_URL=

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Clerk Auth ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://invoice:invoice@localhost:5432/invoice_pipeline
DATABASE_URL_SYNC=postgresql://invoice:invoice@localhost:5432/invoice_pipeline

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── LLM provider: ollama | lm_studio | openai | anthropic | gemini | llamacpp | auto ──
LLM_PROVIDER=auto

# Ollama (local, OpenAI-compatible)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b

# LM Studio (local, OpenAI-compatible). Used by default if reachable.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# llama.cpp (OpenAI-compatible local server)
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=local-model
LLAMACPP_API_KEY=not-needed
LLAMACPP_CONTEXT_LENGTH=4096
LLAMACPP_TEMPERATURE=0.2
LLAMACPP_MAX_TOKENS=2048

# ── Generation ─────────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2

# ── OCR engine: tesseract | paddleocr ─────────────────────────────────────────
OCR_ENGINE=tesseract

# ── Pipeline ───────────────────────────────────────────────────────────────────
LOW_CONFIDENCE_THRESHOLD=0.75
MAX_UPLOAD_SIZE_MB=25

# ── Webhooks ───────────────────────────────────────────────────────────────────
REVIEW_WEBHOOK_URL=

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

